#include <winver.h>
1 ICON "fission.ico"
1 VERSIONINFO
FILEVERSION     VMAJ,VMIN,0,0
PRODUCTVERSION  VMAJ,VMIN,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Fission"
      VALUE "FileDescription", "Fission CAD"
      VALUE "FileVersion", VSTR
      VALUE "InternalName", "Fission"
      VALUE "OriginalFilename", "Fission.exe"
      VALUE "ProductName", "Fission"
      VALUE "ProductVersion", VSTR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
